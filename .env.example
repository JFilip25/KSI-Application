# Your OpenApply tenant root, for example https://school.openapply.com
OPENAPPLY_BASE_URL=
OPENAPPLY_CLIENT_ID=
OPENAPPLY_CLIENT_SECRET=

# Keep true until a sandbox submission has been checked in OpenApply.
OPENAPPLY_DRY_RUN=true

# Optional: map form values to OpenApply custom-field IDs.
# Example: {"student":{"academic_year":"12345"},"parent":{"mobile":"67890","google_education_consent":"67891","marketing_consent":"67892"}}
OPENAPPLY_CUSTOM_FIELD_MAP={}
