# OpenApply tenant root
OPENAPPLY_BASE_URL=https://ksimontenegro.openapply.com
OPENAPPLY_CLIENT_ID=
OPENAPPLY_CLIENT_SECRET=

# Set to the single word false to send applications to OpenApply. Anything else is test mode.
OPENAPPLY_DRY_RUN=true

# Optional overrides of the built-in KSI field map (see README), e.g. {"student":{"summary":123456}}
OPENAPPLY_CUSTOM_FIELD_MAP={}
